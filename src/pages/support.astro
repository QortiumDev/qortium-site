---
import BaseLayout from '../layouts/BaseLayout.astro';
import QdnLink from '../components/QdnLink.astro';
import { SUPPORT, CRYPTO, LINKS } from '../data/site';

const title = 'Support Qortium';
const description =
  'Qortium has real recurring costs behind it. Voluntary support keeps releases, testing, and the Previewnet infrastructure running.';

const costs = [
  {
    item: 'Regxa VPS',
    covers: 'Previewnet seed node, QDN data, and the qortium.app gateway',
    amount: '$15 / month',
  },
  {
    item: 'Netcup VPS',
    covers: 'Second Previewnet seed node, for redundancy across providers',
    amount: 'about $7 / month',
  },
  {
    item: 'AI development tools',
    covers: 'Two assistant subscriptions used daily for research, implementation, review, testing, and documentation',
    amount: '$212 / month',
  },
  {
    item: 'Connectivity',
    covers: 'Phone and network access used for maintenance and testing',
    amount: '$45 / month',
  },
  {
    item: 'qortium.app domain',
    covers: 'This website and the public gateway',
    amount: 'about $37 / year',
  },
];

const covered = [
  ['$5 / month', 'The second seed node moves to a larger plan — more memory headroom on the node that has run out before.'],
  ['$30 / month', 'All infrastructure is covered: both seed nodes, the gateway, and the domain.'],
  ['$135 / month', 'Infrastructure plus one of the two development tool subscriptions.'],
  ['$240 / month', 'Infrastructure plus both.'],
  ['$300 / month', 'Everything above, with a margin for processing fees and currency conversion.'],
];

const upgrades = [
  {
    what: 'Netcup seed node',
    now: '2 vCPU / 4 GB / 128 GB',
    next: '4 vCPU / 8 GB / 256 GB',
    cost: 'about $5 / month',
  },
  {
    what: 'Regxa seed node',
    now: '2 vCPU / 4 GB / 120 GB',
    next: '4 vCPU / 8 GB / 240 GB',
    cost: '$15 / month',
  },
  {
    what: 'Development tooling',
    now: 'mid usage tier',
    next: '4x the usage limit',
    cost: '$100 / month each',
  },
];

// Approximate share of a $10 contribution that reaches the work, after the
// platform's cut and PayPal's processing fee. Every rail here settles through
// PayPal, so the processing fee is the same on all of them (US commercial rate,
// 3.49% + $0.49) and only the platform's cut varies. Figures are rounded and
// deliberately conservative — do not present them as exact.
const fees = [
  { method: 'PayPal (here)', cut: 'no platform fee', gets: 'about $9.15' },
  { method: 'Liberapay', cut: 'no platform fee', gets: 'about $9.15' },
  { method: 'Ko-fi', cut: '5%', gets: 'about $8.65' },
];

const boundaries = [
  {
    h: 'Everything stays open',
    p: 'Nothing is paywalled or becomes subscriber-only. Every repository stays open source under its existing license.',
  },
  {
    h: 'No roadmap control',
    p: 'Support does not buy priority over other users, influence over what gets built, or a private channel.',
  },
  {
    h: 'No private support tier',
    p: 'Bugs and questions are handled the same way for everyone, in public, wherever they are filed.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: SUPPORT.pageUrl,
};
---
<BaseLayout title={title} description={description} path="/support" jsonLd={jsonLd}>
  <section class="hero">
    <div class="container">
      <div class="hero-head">
        <h1>Support the work</h1>
      </div>
      <p class="lede measure">
        I&rsquo;m QuickMythril. I help maintain Qortium &mdash; the Core node,
        the Home desktop and Android app, a number of the QDN apps, and the
        Previewnet seed nodes and gateway that keep it reachable.
        <strong>7R15M3G157U5 also helps maintain Qortium</strong> &mdash; much
        of the platform&rsquo;s rebuild from the Qortal split is his work.
        Others contribute too. Keeping it running costs real money every month,
        and this page is where that is visible and where you can help cover it
        &mdash; or <a href="#support-7r15">support 7R15 directly</a>.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="#ways">Choose an amount</a>
        <a class="btn btn--ghost" href={SUPPORT.paypal.oneTime}>Give once</a>
        <a class="btn btn--ghost" href="#crypto">Send crypto</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What your support goes towards</h2>
      <p class="muted measure">
        These are the recurring costs behind Qortium development and the public
        Previewnet infrastructure. Amounts are approximate and change with
        provider pricing.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Cost</th>
              <th>What it covers</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody>
            {costs.map((c) => (
              <tr>
                <td><strong>{c.item}</strong></td>
                <td>{c.covers}</td>
                <td>{c.amount}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted measure">
        That is roughly <strong>$279 per month</strong>, plus the yearly domain
        charge. The target for this page is <strong>$300 per month</strong>.
        The two development tool subscriptions are the largest line by far, and
        they are listed deliberately rather than hidden under &ldquo;tools&rdquo;
        &mdash; they are general-purpose developer tools used across all of this
        work, not dedicated project infrastructure. AI-assisted changes go
        through the same review and testing as everything else.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What each level covers</h2>
      <p class="muted measure">
        Support adds up in a specific order, and the first step is small and
        concrete rather than a distant goal.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Monthly total</th>
              <th>What it covers</th>
            </tr>
          </thead>
          <tbody>
            {covered.map(([amount, what]) => (
              <tr>
                <td><strong>{amount}</strong></td>
                <td>{what}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <h3>Past the target</h3>
      <p class="muted measure">
        Support beyond the running costs goes into better seed nodes and more
        development capacity — committed only once it has held steady for a few
        months, not the moment it is first reached.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Upgrade</th>
              <th>Now</th>
              <th>Next</th>
              <th>Extra cost</th>
            </tr>
          </thead>
          <tbody>
            {upgrades.map((u) => (
              <tr>
                <td><strong>{u.what}</strong></td>
                <td>{u.now}</td>
                <td>{u.next}</td>
                <td>{u.cost}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted measure">
        The seed nodes are the clearest win: doubling the smaller one costs
        about $5 a month and directly addresses the memory pressure that has
        taken it offline before.
      </p>
    </div>
  </section>

  <section class="section" id="ways">
    <div class="container">
      <h2>Ways to support</h2>
      <p class="muted measure">
        Monthly support is the most useful, because it is what makes the
        running costs predictable. Any amount helps &mdash; these are just the
        common ones.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href={SUPPORT.paypal.monthly3}>$3 / month</a>
        <a class="btn btn--primary" href={SUPPORT.paypal.monthly8}>$8 / month</a>
        <a class="btn btn--primary" href={SUPPORT.paypal.monthly20}>$20 / month</a>
        <a class="btn btn--ghost" href={SUPPORT.paypal.oneTime}>Give once, any amount</a>
      </div>
      <p class="muted measure">
        These run through PayPal, and you do not need a PayPal account to use
        them &mdash; monthly and one-time both take debit and credit cards at
        the checkout. Monthly support renews automatically, and you can change
        or cancel it yourself at any time from
        <strong>Settings &rsaquo; Payments &rsaquo; Automatic payments</strong>
        in your PayPal account &mdash; you never have to contact me. The
        one-time link lets you enter any amount you like, and sets up nothing
        recurring.
      </p>
      <h3>Other platforms</h3>
      <p class="muted measure">
        If you already use one of these, they work just as well.
      </p>
      <div class="grid grid--2">
        <div class="card">
          <h3>Ko-fi</h3>
          <p class="muted">
            One-time or monthly support, paid through PayPal. Monthly support
            renews automatically through PayPal&rsquo;s Automatic Payments.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href={SUPPORT.kofi}>Open Ko-fi</a>
          </div>
        </div>
        <div class="card">
          <h3>Liberapay</h3>
          <p class="muted">
            Open-source funding platform that takes no cut &mdash; only the
            payment processor&rsquo;s fee applies. Payments run through PayPal,
            which asks you to confirm each renewal rather than charging
            automatically, so it needs a little more from you than the options
            above.
          </p>
          <div class="btn-row">
            <a class="btn btn--ghost" href={SUPPORT.liberapay}>Open Liberapay</a>
          </div>
        </div>
      </div>

      <h3>Which method gets the most through</h3>
      <p class="muted measure">
        Every platform takes something, and I would rather you knew than
        guessed. Roughly, out of a $10 monthly contribution:
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Method</th>
              <th>Platform's cut</th>
              <th>Reaches the work</th>
            </tr>
          </thead>
          <tbody>
            {fees.map((f) => (
              <tr>
                <td><strong>{f.method}</strong></td>
                <td>{f.cut}</td>
                <td>{f.gets}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted measure">
        Figures are approximate &mdash; processing fees vary by country and
        payment type. Everything here settles through PayPal, so the processing
        fee is much the same across all of them and the only real difference is
        the platform&rsquo;s cut on top. Pick whatever is easiest for you,
        though &mdash; a contribution you actually make beats a cheaper one you
        do not.
      </p>
    </div>
  </section>

  <section class="section" id="crypto">
    <div class="container">
      <h2>Send crypto</h2>
      <p class="muted measure">
        You can also send QORT to me directly. One thing to understand first:
        <strong>Qortium Previewnet has no native coin</strong>, so this is not a
        Previewnet address &mdash; it is an address on the
        <strong>Qortal mainnet</strong> chain, and QORT sent to it moves on that
        chain.
      </p>
      <div class="grid grid--2">
        <div class="card">
          <h3>QORT (Qortal mainnet)</h3>
          <p class="muted">
            Send QORT on the Qortal mainnet chain to this address. Click or tap
            it to copy:
          </p>
          <code class="addr" data-copy>{CRYPTO.quickmythril.qortAddress}</code>
        </div>
        <div class="card">
          <h3>Other coins</h3>
          <p class="muted">
            More coins are listed on
            <a
              href={CRYPTO.quickmythril.qdnSiteGateway}
              data-qdn-href={CRYPTO.quickmythril.qdnSiteResource}
            >my QDN site</a>, and that list is being expanded. Inside Qortium,
            the same site is
            <QdnLink resource={CRYPTO.quickmythril.qdnSiteResource} />.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="support-7r15">
    <div class="container">
      <h2>Support 7R15</h2>
      <p class="muted measure">
        7R15M3G157U5&rsquo;s support options are crypto-only for now &mdash;
        more options may come later. Anything you send here goes directly to
        him, not through me.
      </p>
      <div class="grid grid--2">
        <div class="card">
          <h3>QORT (Qortal mainnet)</h3>
          <p class="muted">
            Send QORT on the Qortal mainnet chain to his address. Click or tap
            it to copy:
          </p>
          <code class="addr" data-copy>{CRYPTO.tris.qortAddress}</code>
        </div>
        <div class="card">
          <h3>Donation app</h3>
          <p class="muted">
            His Donation app is live on Qortium Previewnet QDN &mdash; open
            <a
              href={CRYPTO.tris.donationAppGateway}
              data-qdn-href={CRYPTO.tris.donationAppResource}
            >the Donation app</a> in a browser, or inside Qortium at
            <QdnLink resource={CRYPTO.tris.donationAppResource} />.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What support does and does not buy</h2>
      <div class="grid grid--2">
        {boundaries.map((c) => (
          <div class="card">
            <h3>{c.h}</h3>
            <p class="muted">{c.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Billing, refunds, and the details</h2>
      <p class="muted measure">
        Everything in this section applies to the PayPal, Ko-fi, and Liberapay
        options above. Crypto works differently &mdash; see the note below.
      </p>
      <div class="card">
        <p class="muted">
          <strong>Billing and cancellation.</strong> Recurring support is billed
          once a month, starting the day you sign up, and continues until you
          cancel. For the monthly options above, cancel from
          <strong>Settings &rsaquo; Payments &rsaquo; Automatic payments</strong>
          in your PayPal account &mdash; on Ko-fi or Liberapay, do it in your
          account there. Either way you never have to contact me. Cancelling
          stops future payments and you keep access until the end of the period
          you have already paid for; that period is not prorated. Amounts are in
          US dollars, and your bank or card issuer may apply its own conversion
          rate and fees.
        </p>
        <p class="muted">
          <strong>Refunds.</strong> If you were charged by mistake, changed your
          mind, or something here was not what you expected, email me within 30
          days and I will refund it in full &mdash; no explanation needed.
          Refunds return to the payment method you used and usually appear
          within 5&ndash;10 business days.
        </p>
        <p class="muted">
          <strong>Crypto.</strong> Crypto payments are irreversible. They go
          directly to the listed recipient&rsquo;s chain address &mdash; mine or
          7R15&rsquo;s &mdash; and are not covered by the refund policy above,
          for either of us. Double-check the address and the chain before
          sending: the QORT addresses on this page are on the Qortal mainnet
          chain, not Qortium Previewnet.
        </p>
        <p class="muted">
          <strong>Contact.</strong> Questions about supporting the work,
          billing, or refunds go to
          <a href={`mailto:${SUPPORT.email}`}>{SUPPORT.email}</a>, answered
          personally and usually within a few days. Bugs and feature requests
          belong on the issue tracker of the relevant repository instead, where
          they stay public and searchable.
        </p>
        <p class="muted">
          <strong>Privacy.</strong> Payments are handled entirely by the
          platform you choose &mdash; your card number, bank details, and
          billing address stay with them and are never seen or stored here.
          What I do see, because PayPal shows it to whoever receives a payment,
          is the name and email address on your PayPal account, the amount, and
          any message you send. Email you send is kept to reply and for
          payment records; supporter information is never sold, rented, or
          shared, and there is no marketing email. This site sets no tracking
          cookies and runs no analytics, though version numbers on some pages
          are fetched from GitHub as the page loads.
        </p>
        <p class="muted">
          <strong>Terms.</strong> Support here is voluntary. It is not a
          purchase of software, a licence, a service contract, or a promise that
          any feature will be built or that the network will keep running.
          Qortium is preview software, provided as-is under the open source
          licences in its repositories. Support is <strong>not a tax-deductible
          charitable donation</strong> &mdash; this is an individual developer,
          not a registered charity. Qortium is an independent project: it is not
          Qortal, and it is not affiliated with or endorsed by the Qortal
          project.
        </p>
        <div class="btn-row">
          <a class="btn btn--ghost" href={LINKS.siteRepo}>Source for this site</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Progressive enhancement, both parts a harmless no-op on clearnet:
       1) qdn:// links — anchors carrying data-qdn-href get their https gateway
          href swapped for the qdn:// URI when the page is served by Qortium
          Core (render or gateway path). Detection checks for the window._qdn*
          globals Core's HTMLParser injects on those paths (_qdnContext plus
          _qdnService — see HTMLParser.java); Core's injected q-apps script
          intercepts clicks on qdn:// hrefs and routes them natively. This runs
          before BaseLayout's end-of-body external-link handler, so swapped
          anchors are no longer http(s) and skip the copy-URL modal.
       2) crypto addresses — code.addr[data-copy] blocks become click-to-copy
          buttons (same behavior/styling contract as BaseLayout's qdn-ref copy);
          without JS they stay selectable text. -->
  <script is:inline>
    (function () {
      var ctx = window._qdnContext;
      var inQortium =
        typeof ctx === 'string' && ctx.length > 0 &&
        typeof window._qdnService !== 'undefined';
      if (inQortium) {
        var links = document.querySelectorAll('a[data-qdn-href]');
        Array.prototype.forEach.call(links, function (a) {
          var qdn = a.getAttribute('data-qdn-href');
          if (qdn && qdn.indexOf('qdn://') === 0) a.setAttribute('href', qdn);
        });
      }

      var addrs = document.querySelectorAll('code.addr[data-copy]');
      Array.prototype.forEach.call(addrs, function (code) {
        var value = (code.textContent || '').trim();
        if (!value) return;
        var resetTimer = null;
        code.setAttribute('role', 'button');
        code.setAttribute('tabindex', '0');
        code.setAttribute('title', 'Copy address');
        code.setAttribute('aria-live', 'polite');
        code.setAttribute('data-copyable', 'true');

        function showCopied() {
          if (resetTimer) window.clearTimeout(resetTimer);
          code.setAttribute('data-state', 'copied');
          code.textContent = 'Copied!';
          resetTimer = window.setTimeout(function () {
            code.removeAttribute('data-state');
            code.textContent = value;
          }, 1200);
        }

        function copyFallback() {
          try {
            var ta = document.createElement('textarea');
            ta.value = value;
            ta.setAttribute('readonly', '');
            ta.style.position = 'absolute';
            ta.style.left = '-9999px';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            showCopied();
          } catch (e) {}
        }

        function copyAddr(e) {
          if (e) e.preventDefault();
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(value).then(showCopied, copyFallback);
          } else {
            copyFallback();
          }
        }

        code.addEventListener('click', copyAddr);
        code.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') copyAddr(e);
        });
      });
    })();
  </script>
</BaseLayout>
