---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SUPPORT, LINKS } from '../data/site';

const title = 'Support Qortium';
const description =
  'Qortium has real recurring costs behind it. Voluntary support keeps releases, testing, and the Previewnet infrastructure running.';

const costs = [
  {
    item: 'Regxa VPS',
    covers: 'Previewnet seed node, QDN data, and the qortium.app gateway',
    amount: '$15 / month',
  },
  {
    item: 'Netcup VPS',
    covers: 'Second Previewnet seed node, for redundancy across providers',
    amount: 'about $7 / month',
  },
  {
    item: 'AI development tools',
    covers: 'Two assistant subscriptions used daily for research, implementation, review, testing, and documentation',
    amount: '$212 / month',
  },
  {
    item: 'Connectivity',
    covers: 'Phone and network access used for maintenance and testing',
    amount: '$45 / month',
  },
  {
    item: 'qortium.app domain',
    covers: 'This website and the public gateway',
    amount: 'about $37 / year',
  },
];

const covered = [
  ['$5 / month', 'The second seed node moves to a larger plan — more memory headroom on the node that has run out before.'],
  ['$30 / month', 'All infrastructure is covered: both seed nodes, the gateway, and the domain.'],
  ['$135 / month', 'Infrastructure plus one of the two development tool subscriptions.'],
  ['$240 / month', 'Infrastructure plus both.'],
  ['$300 / month', 'Everything above, with a margin for processing fees and currency conversion.'],
];

const upgrades = [
  {
    what: 'Netcup seed node',
    now: '2 vCPU / 4 GB / 128 GB',
    next: '4 vCPU / 8 GB / 256 GB',
    cost: 'about $5 / month',
  },
  {
    what: 'Regxa seed node',
    now: '2 vCPU / 4 GB / 120 GB',
    next: '4 vCPU / 8 GB / 240 GB',
    cost: '$15 / month',
  },
  {
    what: 'Development tooling',
    now: 'mid usage tier',
    next: '4x the usage limit',
    cost: '$100 / month each',
  },
];

// Approximate share of a $10/month contribution that reaches the work, after the
// platform's cut and typical processing fees. Bank payments are the outlier:
// ACH is 0.8% capped at $5, against roughly 3% for a card.
const fees = [
  { method: 'Bank payment (here)', cut: 'no platform fee', gets: 'about $9.90' },
  { method: 'Card (here)', cut: 'no platform fee', gets: 'about $9.40' },
  { method: 'Liberapay', cut: 'no platform fee', gets: 'about $9.40' },
  { method: 'Ko-fi', cut: '5%', gets: 'about $8.90' },
  { method: 'Patreon (planned)', cut: '10%', gets: 'about $8.40' },
];

const boundaries = [
  {
    h: 'Everything stays open',
    p: 'Nothing is paywalled or becomes subscriber-only. Every repository stays open source under its existing license.',
  },
  {
    h: 'No roadmap control',
    p: 'Support does not buy priority over other users, influence over what gets built, or a private channel.',
  },
  {
    h: 'No private support tier',
    p: 'Bugs and questions are handled the same way for everyone, in public, wherever they are filed.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: SUPPORT.pageUrl,
};
---
<BaseLayout title={title} description={description} path="/support" jsonLd={jsonLd}>
  <section class="hero">
    <div class="container">
      <div class="hero-head">
        <h1>Support the work</h1>
      </div>
      <p class="lede measure">
        I&rsquo;m QuickMythril. I help maintain Qortium &mdash; the Core node,
        the Home desktop and Android app, a number of the QDN apps, and the
        Previewnet seed nodes and gateway that keep it reachable. Others work on
        it too. Keeping it running costs real money every month, and this page
        is where that is visible and where you can help cover it.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href="#ways">Choose an amount</a>
        <a class="btn btn--ghost" href={SUPPORT.card.oneTime}>Give once</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What your support goes towards</h2>
      <p class="muted measure">
        These are the recurring costs behind Qortium development and the public
        Previewnet infrastructure. Amounts are approximate and change with
        provider pricing.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Cost</th>
              <th>What it covers</th>
              <th>Amount</th>
            </tr>
          </thead>
          <tbody>
            {costs.map((c) => (
              <tr>
                <td><strong>{c.item}</strong></td>
                <td>{c.covers}</td>
                <td>{c.amount}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted measure">
        That is roughly <strong>$279 per month</strong>, plus the yearly domain
        charge. The target for this page is <strong>$300 per month</strong>.
        The two development tool subscriptions are the largest line by far, and
        they are listed deliberately rather than hidden under &ldquo;tools&rdquo;
        &mdash; they are general-purpose developer tools used across all of this
        work, not dedicated project infrastructure. AI-assisted changes go
        through the same review and testing as everything else.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What each level covers</h2>
      <p class="muted measure">
        Support adds up in a specific order, and the first step is small and
        concrete rather than a distant goal.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Monthly total</th>
              <th>What it covers</th>
            </tr>
          </thead>
          <tbody>
            {covered.map(([amount, what]) => (
              <tr>
                <td><strong>{amount}</strong></td>
                <td>{what}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <h3>Past the target</h3>
      <p class="muted measure">
        Support beyond the running costs goes into better seed nodes and more
        development capacity — committed only once it has held steady for a few
        months, not the moment it is first reached.
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Upgrade</th>
              <th>Now</th>
              <th>Next</th>
              <th>Extra cost</th>
            </tr>
          </thead>
          <tbody>
            {upgrades.map((u) => (
              <tr>
                <td><strong>{u.what}</strong></td>
                <td>{u.now}</td>
                <td>{u.next}</td>
                <td>{u.cost}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted measure">
        The seed nodes are the clearest win: doubling the smaller one costs
        about $5 a month and directly addresses the memory pressure that has
        taken it offline before.
      </p>
    </div>
  </section>

  <section class="section" id="ways">
    <div class="container">
      <h2>Ways to support</h2>
      <p class="muted measure">
        Monthly support by card or bank is the most useful, because it is what
        makes the running costs predictable. Any amount helps &mdash; these are
        just the common ones.
      </p>
      <div class="btn-row">
        <a class="btn btn--primary" href={SUPPORT.card.monthly3}>$3 / month</a>
        <a class="btn btn--primary" href={SUPPORT.card.monthly8}>$8 / month</a>
        <a class="btn btn--primary" href={SUPPORT.card.monthly20}>$20 / month</a>
        <a class="btn btn--ghost" href={SUPPORT.card.oneTime}>Give once, any amount</a>
      </div>
      <p class="muted measure">
        These take cards, Apple Pay and Google Pay, bank payments, Cash App
        Pay, and Klarna. Monthly support renews automatically, and you can
        change or cancel it yourself from the link in your receipt email.
      </p>
      <h3>Other platforms</h3>
      <p class="muted measure">
        If you already use one of these, or prefer to pay through PayPal, they
        work just as well.
      </p>
      <div class="grid grid--2">
        <div class="card">
          <h3>Ko-fi</h3>
          <p class="muted">
            One-time or monthly support, paid through PayPal. Monthly support
            renews automatically through PayPal&rsquo;s Automatic Payments.
          </p>
          <div class="btn-row">
            <a class="btn btn--primary" href={SUPPORT.kofi}>Open Ko-fi</a>
          </div>
        </div>
        <div class="card">
          <h3>Liberapay</h3>
          <p class="muted">
            Open-source funding platform that takes no cut &mdash; only the
            payment processor&rsquo;s fee applies. Payments currently run
            through PayPal, which asks you to confirm each renewal rather than
            charging automatically.
          </p>
          <div class="btn-row">
            <a class="btn btn--ghost" href={SUPPORT.liberapay}>Open Liberapay</a>
          </div>
        </div>
        <div class="card">
          <h3>Patreon</h3>
          <p class="muted">
            Planned, but not open yet. It carries the highest platform fee of
            any option here, so it will be added last rather than first. There
            is nothing to click yet &mdash; the options above all work today.
          </p>
        </div>
      </div>

      <h3>Which method gets the most through</h3>
      <p class="muted measure">
        Every platform takes something, and I would rather you knew than
        guessed. Roughly, out of a $10 monthly contribution:
      </p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Method</th>
              <th>Platform's cut</th>
              <th>Reaches the work</th>
            </tr>
          </thead>
          <tbody>
            {fees.map((f) => (
              <tr>
                <td><strong>{f.method}</strong></td>
                <td>{f.cut}</td>
                <td>{f.gets}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="muted measure">
        Figures are approximate &mdash; processing fees vary by country, card,
        and payment type. The one worth knowing: <strong>paying by bank costs
        about a third of what a card costs</strong>, because bank payments are
        charged at 0.8% capped at $5 while cards are around 3%. On the larger
        amounts that difference is real money. Pick whatever is easiest for
        you, though &mdash; a card contribution you actually make beats a bank
        transfer you do not.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>What support does and does not buy</h2>
      <div class="grid grid--2">
        {boundaries.map((c) => (
          <div class="card">
            <h3>{c.h}</h3>
            <p class="muted">{c.p}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Billing, refunds, and the details</h2>
      <div class="card">
        <p class="muted">
          <strong>Billing and cancellation.</strong> Recurring support is billed
          once a month, starting the day you sign up, and continues until you
          cancel. For card and bank support, manage or cancel it yourself from
          the link in your receipt email; on Ko-fi or Liberapay, do it in your
          account there. Either way you never have to contact me. Cancelling
          stops future payments; the period already paid for is not prorated.
          Amounts are in US dollars, and your bank may apply its own conversion
          rate and fees.
        </p>
        <p class="muted">
          <strong>Refunds.</strong> If you were charged by mistake, changed your
          mind, or something here was not what you expected, email me within 30
          days and I will refund it in full &mdash; no explanation needed.
          Refunds return to the payment method you used and usually appear
          within 5&ndash;10 business days.
        </p>
        <p class="muted">
          <strong>Contact.</strong> Questions about supporting the work,
          billing, or refunds go to
          <a href={`mailto:${SUPPORT.email}`}>{SUPPORT.email}</a>, answered
          personally and usually within a few days. Bugs and feature requests
          belong on the issue tracker of the relevant repository instead, where
          they stay public and searchable.
        </p>
        <p class="muted">
          <strong>Privacy.</strong> Payments are handled entirely by the
          platform you choose &mdash; your card number, bank details, and
          billing address stay with them and are never seen or stored here.
          What is visible is the name or handle you supported under, the amount,
          and any message you send. Email you send is kept to reply and for
          payment records; supporter information is never sold, rented, or
          shared, and there is no marketing email. This site sets no tracking
          cookies and runs no analytics, though version numbers on some pages
          are fetched from GitHub as the page loads.
        </p>
        <p class="muted">
          <strong>Terms.</strong> Support here is voluntary. It is not a
          purchase of software, a licence, a service contract, or a promise that
          any feature will be built or that the network will keep running.
          Qortium is preview software, provided as-is under the open source
          licences in its repositories. Support is <strong>not a tax-deductible
          charitable donation</strong> &mdash; this is an individual developer,
          not a registered charity. Qortium is an independent project: it is not
          Qortal, and it is not affiliated with or endorsed by the Qortal
          project.
        </p>
        <div class="btn-row">
          <a class="btn btn--ghost" href={LINKS.siteRepo}>Source for this site</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
